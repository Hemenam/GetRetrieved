{
  "openapi": "3.1.0",
  "info": {
    "title": "HRLearnium Course Assistant API",
    "description": "Authenticated course Q&A with cited evidence. Natural questions can return a natural grounded explanation (default) or verbatim excerpts (response_mode). Social replies are labelled conversation and contain no course evidence. An LLM backend is required for natural-language answerability and explanations. Configured backend: openai_compatible. ",
    "version": "0.3.0"
  },
  "paths": {
