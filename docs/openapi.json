      "QueryRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 2,
            "title": "Question"
          },
          "response_mode": {
            "type": "string",
            "enum": [
              "verbatim",
              "explained"
            ],
            "title": "Response Mode",
            "description": "Both modes accept natural questions. Verbatim returns exact source excerpts; explained (default) returns a natural cited answer; exact evidence remains in excerpts.",
            "default": "explained"
          },
          "retrieval_mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "full_context",
                  "hybrid",
                  "hybrid_rerank"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieval Mode",
            "description": "Override evidence retrieval for this request only. Omit to use the server default. Hybrid modes require current course embeddings; reranking also needs its runtime/model files."
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id",
            "description": "Omit this field for your first question. For a follow-up, copy the conversation_id returned by a successful request for this same user and course. Do not invent an ID."
          },
          "include_evaluation": {
            "type": "boolean",
            "title": "Include Evaluation",
            "description": "Include timings, ranking and configuration for evaluation tools.",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "QueryRequest",
        "examples": [
          {
            "question": "مدل ۳۰-۳۰-۳۰ چطور به اولویت‌بندی در بحران کمک می‌کند؟",
            "response_mode": "explained"
          }
        ]
      },
      "QueryResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "partial",
              "refused",
              "clarification",
              "conversation",
              "error"
            ],
