        }
      },
      "get": {
        "tags": [
          "content"
        ],
        "summary": "List Documents",
        "operationId": "list_documents_v1_courses__course_id__documents_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "course_id",
