# Generate an actual secret with: hrlearnium init
HR_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
HR_JWT_ISSUER=django-lms
HR_JWT_AUDIENCE=hrlearnium-api
HR_DATABASE_PATH=data/hrlearnium.sqlite3
# openai_compatible uses a privately configured API key; see README.
# ollama uses local models; literal is ONLY a no-LLM diagnostic backend.
HR_MODEL_BACKEND=openai_compatible
HR_API_BASE_URL=
HR_API_KEY=
HR_API_MODEL=
HR_API_EMBEDDING_MODEL=
HR_API_EMBEDDING_REVISION=1
HR_API_STRUCTURED_OUTPUT=json_schema
HR_API_MAX_COMPLETION_TOKENS=4096
HR_OLLAMA_BASE_URL=http://127.0.0.1:11434
HR_EMBEDDING_MODEL=qwen3-embedding:0.6b
HR_SELECTOR_MODEL=qwen3:8b
HR_MODEL_TIMEOUT_SECONDS=120
HR_RETRIEVAL_MODE=full_context
# Optional experiment C: hybrid_rerank (requires the [rerank] extra and model files).
HR_CANDIDATE_LIMIT=8
HR_RERANK_POOL_LIMIT=32
HR_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Set a specific model commit or a local model folder for reproducible experiments.
HR_RERANKER_REVISION=
HR_RERANKER_DEVICE=cpu
HR_RERANKER_LOCAL_FILES_ONLY=true
HR_RERANKER_BATCH_SIZE=4
HR_RERANKER_MAX_TOKENS=8192
HR_ENABLE_DOCS=true
HR_ALLOW_REMOTE_MODELS=true
# Fail closed: model errors return 503, never fall back to an unverified answer.
